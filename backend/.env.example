# ── Server Configuration ──────────────────────────────────
PORT=8000
NODE_ENV=production

# ── MongoDB Atlas Connection ──────────────────────────────
# In MongoDB Atlas: Network Access -> Whitelist IP 0.0.0.0/0
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/xmart?retryWrites=true&w=majority

# ── Security & Authentication ─────────────────────────────
JWT_SECRET=xmart_super_secret_production_key_2026
JWT_EXPIRES_IN=7d

# ── Frontend URL (Netlify Domain) ─────────────────────────
CLIENT_URL=https://your-site-name.netlify.app

# ── Brevo Transactional Email Service ─────────────────────
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=your_email@domain.com
SENDER_NAME=X-Mart Store

# ── Razorpay Payment Gateway ──────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── Geoapify Maps & Geocoding ─────────────────────────────
GEOAPIFY_API_KEY=your_geoapify_key_here
